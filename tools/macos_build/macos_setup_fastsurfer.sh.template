#!/bin/bash

export FASTSURFER_HOME=/Applications/<fastsurfer>
source $FASTSURFER_HOME/venv/bin/activate
# $FASTSURFER_HOME comes first, matching what run_fastsurfer.sh does before invoking python.
# Without it, FastSurfer's own modules resolve to the copy pip placed in site-packages rather than
# to the source shipped in $FASTSURFER_HOME, so the console and the pipeline import different
# copies of the same module -- and any package that setuptools discovery missed is not importable
# in the console at all.
export PYTHONPATH=$FASTSURFER_HOME:$FASTSURFER_HOME/venv/lib/python<python_version>/site-packages:$PYTHONPATH
export FREESURFER_HOME=$FASTSURFER_HOME/fs-pruned
source $FREESURFER_HOME/SetUpFreeSurfer.sh > /dev/null
echo
echo "This is the FastSurfer console. Call \`run_fastsurfer.sh -t1 ...\` in here! " 
echo "See also https://deep-mi.org/FastSurfer/stable/overview/INSTALL.html#macos"

if ! grep -q "export PATH=\"$(brew --prefix)/opt/grep/libexec/gnubin:\$PATH\"" ~/.bash_profile; then 
    echo "export PATH=\"$(brew --prefix)/opt/grep/libexec/gnubin:\$PATH\"" >> ~/.bash_profile;
    export PATH="$(brew --prefix)/opt/grep/libexec/gnubin:$PATH" 
    echo "GNU grep has been added to path"
fi

if ! grep -q "export PATH=\"$FASTSURFER_HOME:\$PATH\"" ~/.bash_profile; then 
    echo "export PATH=\"$FASTSURFER_HOME:\$PATH\"" >> ~/.bash_profile; 
    export PATH="$FASTSURFER_HOME:$PATH"
    echo "FastSurfer dir has been added to path"
fi

if [[ -z "${FS_LICENSE}" ]]; then 
    echo "Set FS_LICENSE environmental variable"
fi
