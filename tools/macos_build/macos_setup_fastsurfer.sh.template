#!/bin/bash

# The applet starts `bash --init-file <this script>`, which reads this file *instead of* ~/.bashrc.
# Load that first, so the console keeps the user's own aliases and settings while FastSurfer's PATH
# entries and prompt marker below still win.
if [[ -n "${FASTSURFER_CONSOLE-}" ]]; then
    [[ -r "$HOME/.bashrc" ]] && source "$HOME/.bashrc"
    # one-shot: it is exported, and a shell started from the console is not reading an init file
    unset FASTSURFER_CONSOLE
fi

export FASTSURFER_HOME=/Applications/<fastsurfer>

# Prepend to PATH unless already present, so repeated sourcing does not grow it without bound.
fastsurfer_prepend_path() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) export PATH="$1:$PATH" ;;
    esac
}

# The bundled distribution needs no activation: its bin first on PATH is enough. site-packages is
# found via the prefix and kept off PYTHONPATH, which would otherwise let an unrelated python on
# PATH import binary extensions built for this interpreter.
fastsurfer_prepend_path "$FASTSURFER_HOME/python/bin"

# $FASTSURFER_HOME first, matching what run_fastsurfer.sh does before invoking python: FastSurfer's
# own modules live there, shipped as a source tree rather than installed into the bundle.
export PYTHONPATH="$FASTSURFER_HOME${PYTHONPATH:+:$PYTHONPATH}"

export FREESURFER_HOME=$FASTSURFER_HOME/fs-pruned
# SetUpFreeSurfer.sh and the FreeSurferEnv.sh it sources are not written for strict mode: they read
# variables unguarded and run commands whose failure is normal, so they abort a caller that sourced
# us with `set -u` or `set -e`. Suspend both across them and restore whatever the caller had.
fastsurfer_caller_opts="$-"
set +ue
source $FREESURFER_HOME/SetUpFreeSurfer.sh > /dev/null
case "$fastsurfer_caller_opts" in *u*) set -u ;; esac
case "$fastsurfer_caller_opts" in *e*) set -e ;; esac
unset fastsurfer_caller_opts

# mark the shell, as a virtual environment's activate script would. PS1 is unset in a
# non-interactive shell, hence the default.
PS1="(<fastsurfer>) ${PS1-}"

echo
echo "This is the FastSurfer console. Call \`run_fastsurfer.sh -t1 ...\` in here! " 
echo "In any other bash or zsh Terminal window, set up the same environment with:"
echo "  source $FASTSURFER_HOME/macos_setup_fastsurfer.sh"
echo "See also https://deep-mi.org/FastSurfer/stable/overview/INSTALL.html#macos"

# run_fastsurfer.sh lives here.
fastsurfer_prepend_path "$FASTSURFER_HOME"

# GNU grep, if homebrew provides it. The package bundles everything it runs and does not need
# homebrew, so this is skipped rather than failing when brew is absent.
if command -v brew > /dev/null 2>&1 ; then
    gnubin="$(brew --prefix)/opt/grep/libexec/gnubin"
    [[ -d "$gnubin" ]] && fastsurfer_prepend_path "$gnubin"
    unset gnubin
fi

# Nothing is written to ~/.zprofile or ~/.bash_profile on purpose. Persisting just the PATH entry
# was a trap: run_fastsurfer.sh would then be found in a plain shell while python3 still resolved to
# Apple's system python and FREESURFER_HOME was unset, failing with a confusing TypeError. Sourcing
# this script is the whole setup, and the package leaves no per-version leftovers in dotfiles.
unset -f fastsurfer_prepend_path

if [[ -z "${FS_LICENSE-}" ]]; then
    echo "Set FS_LICENSE environmental variable"
fi
